# Copiar a .env y ajustar. .env nunca se commitea (ver .gitignore).

# --- Postgres ---
POSTGRES_DB=cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=changeme

# --- Auth (Fase 8) ---
# Firma las cookies de sesión (JWT HS256). Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=changeme
# false solo para probar en http://localhost sin HTTPS; en producción
# detrás de Cloudflare Tunnel (HTTPS) debe quedar en true.
COOKIE_SECURE=true

# --- Subida de audio ---
# Límite de tamaño por archivo, en bytes. Default: 500 MB.
AUDIO_MAX_SIZE_BYTES=524288000
# Trabajos simultáneos (encolados + procesando) antes de rechazar subidas
# nuevas con 429. El worker solo procesa uno a la vez de todos modos; este
# límite evita que la cola/disco crezcan sin control.
MAX_CONCURRENT_JOBS=5
# Días a conservar el audio original de trabajos terminados antes de
# borrarlo (la transcripción en la base de datos no se toca). 0 = nunca
# borrar. Requiere programar `python -m worker.retention` externamente
# (ver backend/src/worker/retention.py), esto solo fija el umbral.
AUDIO_RETENTION_DAYS=0

# --- Whisper / worker ---
# Modelo por defecto para nuevos trabajos. En esta máquina de desarrollo
# usar siempre "tiny" (poca RAM libre). En el ProDesk de producción, tras
# medir en la Fase 5, se sube a "large-v3-turbo" o el que corresponda.
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=4
# Lista separada por comas de modelos a ocultar del selector, p. ej. si
# large-v3 resulta insoportable en la práctica (ver Fase 5 del plan):
# WHISPER_DISABLED_MODELS=large-v3

# --- Límites de memoria de docker-compose (mem_limit por servicio) ---
# Defaults conservadores pensados para una máquina de desarrollo con poca
# RAM libre. En el ProDesk (16GB dedicados) se pueden subir, especialmente
# WORKER_MEM_LIMIT si se habilitan modelos grandes.
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=1g
CADDY_MEM_LIMIT=128m
